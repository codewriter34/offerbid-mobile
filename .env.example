# OfferBid Mobile — Environment Variables
# Copy this file to .env and fill in your values

# NestJS API
API_BASE_URL=https://offerbid-api.onrender.com/api/v1
SOCKET_URL=wss://offerbid-api.onrender.com/realtime

# Uploads: s3 (default, API presign) or cloudinary (kept for later)
UPLOAD_PROVIDER=s3

# Cloudinary (optional fallback — kept for later)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Google Auth
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Firebase (client config only — no server keys in mobile app)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
